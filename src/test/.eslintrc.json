{
    "parserOptions": {
        "ecmaVersion": 2017
    },
    "globals": {
        "LOAD_TIMEOUT": true,
        "URL_PATH": true
    },
    "env": {
        "jest": true,
        "jasmine": true
    },
    "rules": {
        "max-nested-callbacks": [2, 10],
        "max-len": [
            2,
            250,
            {
                "ignoreTrailingComments": true
            }
        ]
    }
}
